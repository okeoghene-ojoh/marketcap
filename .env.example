# Copy this file to .env.local and fill in your keys (or run scripts\set-keys.ps1).
# Free keys: https://finnhub.io  and  https://twelvedata.com
# Without market keys the app still runs, using sample data labelled "sample".

FINNHUB_API_KEY=
TWELVEDATA_API_KEY=

# Nigerian Exchange (NGX) prices: https://eodhd.com (free key to test; a paid plan for the live site)
EODHD_API_KEY=

# Supabase (accounts + saved portfolios): https://supabase.com → Project → Connect
# Without these, sign-in is hidden and portfolios stay in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
